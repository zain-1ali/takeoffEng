PORT=4000
# On Railway set CLIENT_URL and WEB_URL to the Netlify origin, no trailing slash.
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
MONGODB_URI=mongodb://127.0.0.1:27017/takeoff_studio
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
MAGIC_LINK_TTL_SECONDS=900
INVITE_TTL_SECONDS=604800
# Local disk unless a Railway (or S3) bucket is configured.
FILE_ROOT=uploads
# Railway Object Storage. Attach the bucket to the API service; these names match Railway's variables.
RAILWAY_ENDPOINT=
RAILWAY_BUCKET=
RAILWAY_ACCESS_KEY_ID=
RAILWAY_SECRET_ACCESS_KEY=
RAILWAY_REGION=auto
WEB_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TakeOff Studio <noreply@takeoff.local>
# Verify your domain in Resend, then set MAIL_FROM to that domain. Shared onboarding@resend.dev goes to spam.
MAIL_FROM=TakeOff Studio <noreply@your-domain.com>
MAIL_REPLY_TO=support@your-domain.com
RESEND_API_KEY=
# Google Identity. Add http://localhost:5173 and the live site as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
